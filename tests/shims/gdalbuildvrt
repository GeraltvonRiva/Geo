#!/usr/bin/env python3
"""Test-Shim: gdalbuildvrt + gdal_translate (Teilmenge) auf Basis rasterio.

Aufrufmodi:
  gdalbuildvrt [-input_file_list list.txt] out.vrt
  gdal_translate [-of XYZ] [-co ...] src dst
    - of XYZ: Klartext "x y value" je Pixel (Pixelmitte)
"""
import os
import sys

import numpy as np
import rasterio
from rasterio.transform import from_origin


def build_vrt(argv):
    file_list = []
    out = None
    i = 0
    while i < len(argv):
        if argv[i] == "-input_file_list":
            with open(argv[i + 1]) as fh:
                file_list = [l.strip() for l in fh if l.strip()]
            i += 2
        elif argv[i].startswith("-"):
            i += 1
        else:
            if out is None:
                out = argv[i]
            else:
                file_list.append(argv[i])
            i += 1
    with rasterio.open(file_list[0]) as ref:
        acc = ref.read(1).astype(np.float32)
        nodata = ref.nodata
        profile = ref.profile.copy()
    for p in file_list[1:]:
        with rasterio.open(p) as ds:
            data = ds.read(1).astype(np.float32)
            nd = ds.nodata if ds.nodata is not None else nodata
            mask = acc == nodata
            acc[mask] = data[mask]
    profile.update(driver="GTiff")
    profile.pop("blockxsize", None)
    profile.pop("blockysize", None)
    profile.pop("tiled", None)
    with rasterio.open(out, "w", **profile) as dst:
        dst.write(acc, 1)
    return 0


def _read_xyz(src):
    """Liest XYZ-Klartext (x y value) in ein numpy-Grid + Georeferenz."""
    xs, ys, vals = [], [], []
    with open(src, "r", encoding="utf-8") as fh:
        for line in fh:
            parts = line.split()
            if len(parts) < 3:
                continue
            xs.append(float(parts[0]))
            ys.append(float(parts[1]))
            vals.append(float(parts[2]))
    xs_un = sorted(set(xs))
    ys_un = sorted(set(ys), reverse=True)  # Nord-oben
    width, height = len(xs_un), len(ys_un)
    resx = (xs_un[-1] - xs_un[0]) / max(width - 1, 1)
    resy = (ys_un[0] - ys_un[-1]) / max(height - 1, 1)
    col_idx = {v: i for i, v in enumerate(xs_un)}
    row_idx = {v: i for i, v in enumerate(ys_un)}
    arr = np.zeros((height, width), dtype="float32")
    for x, y, v in zip(xs, ys, vals):
        arr[row_idx[y], col_idx[x]] = v
    transform = from_origin(xs_un[0] - resx / 2, ys_un[0] + resy / 2,
                            resx, resy)
    return arr, transform


def translate(argv):
    of = None
    a_srs = None
    a_nodata = None
    pos = []
    skip = 0
    for i, a in enumerate(argv):
        if skip > 0:
            skip -= 1
            continue
        if a == "-of":
            of = argv[i + 1]; skip = 1
        elif a == "-a_srs":
            a_srs = argv[i + 1]; skip = 1
        elif a == "-a_nodata":
            a_nodata = float(argv[i + 1]); skip = 1
        elif a in ("-co", "-ot"):
            skip = 1
        elif a.startswith("-"):
            continue
        else:
            pos.append(a)
    src, dst = pos[0], pos[1]

    if src.lower().endswith(".xyz") or src.lower().endswith(".xyz.filled"):
        # XYZ-Klartext -> GTiff (echtes GDAL kann XYZ direkt lesen)
        arr, transform = _read_xyz(src)
        profile = dict(driver="GTiff", width=arr.shape[1], height=arr.shape[0],
                        count=1, dtype="float32", transform=transform,
                        crs=rasterio.crs.CRS.from_epsg(25832),
                        nodata=a_nodata)
        with rasterio.open(dst, "w", **profile) as out:
            out.write(arr, 1)
        return 0

    with rasterio.open(src) as ds:
        if of and of.upper() == "XYZ":
            # ALLE Pixel schreiben (auch NoData) – wie das echte XYZ-Format
            arr = ds.read(1)
            for r in range(arr.shape[0]):
                for c in range(arr.shape[1]):
                    x, y = ds.transform * (c + 0.5, r + 0.5)
                    fh = None
            with open(dst, "w") as fh:
                for r in range(arr.shape[0]):
                    for c in range(arr.shape[1]):
                        x, y = ds.transform * (c + 0.5, r + 0.5)
                        fh.write(f"{x} {y} {arr[r, c]}\n")
            return 0
        profile = ds.profile.copy()
        data = ds.read()
        profile.update(driver="GTiff")
        profile.pop("blockxsize", None)
        profile.pop("blockysize", None)
        profile.pop("tiled", None)
        with rasterio.open(dst, "w", **profile) as out:
            out.write(data)
    return 0


if __name__ == "__main__":
    base = os.path.basename(sys.argv[0])
    argv = sys.argv[1:]
    sys.exit(build_vrt(argv) if "buildvrt" in base else translate(argv))
